    {
      "name": "02 — Chuẩn bị đề và mở phòng thi",
      "item": [
        {
          "name": "Tạo rubric",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/courses/{{courseId}}/rubrics",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lecturerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rubricName\": \"Tính đóng gói\",\n  \"criteria\": [\n    {\n      \"criterionName\": \"Khái niệm và vận dụng\",\n      \"description\": \"Giải thích vai trò của private, kiểm tra dữ liệu khi cập nhật và nêu ví dụ đối tượng có invariant.\",\n      \"maxScore\": 10\n    }\n  ]\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const rubricId = pm.response.json().data.id; pm.expect(rubricId).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"rubricId\", rubricId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Tạo câu chính",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/questions",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lecturerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": \"{{courseId}}\",\n  \"rubricId\": \"{{rubricId}}\",\n  \"content\": \"Tính đóng gói trong Java là gì? Hãy giải thích cách nó bảo vệ dữ liệu và minh họa bằng ví dụ.\",\n  \"bloomLevel\": \"UNDERSTAND\",\n  \"aiGenerated\": false\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const questionId = pm.response.json().data.id; pm.expect(questionId).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"questionId\", questionId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Duyệt câu hỏi",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/questions/{{questionId}}/approve",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lecturerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.status).to.eql(\"APPROVED\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Tạo kỳ thi",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/exams",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lecturerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"courseId\": \"{{courseId}}\",\n  \"title\": \"E2E interview {{runId}}\",\n  \"startTime\": \"{{examStart}}\",\n  \"endTime\": \"{{examEnd}}\",\n  \"examConfig\": {\n    \"maxMainQuestions\": 1,\n    \"maxFollowUpQuestions\": 1,\n    \"timeLimitPerTurnSeconds\": 180,\n    \"antiOverlapEnabled\": false\n  }\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const examId = pm.response.json().id; pm.expect(examId).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"examId\", examId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Xếp ca và giao câu",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/exams/{{examId}}/schedule/auto",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lecturerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentIds\": [\n    \"{{studentId}}\"\n  ],\n  \"slotDurationMinutes\": 15,\n  \"breakDurationMinutes\": 0\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const attemptId = pm.response.json() .find(row => row.studentId === pm.collectionVariables.get(\"studentId\")).attemptId; pm.expect(attemptId).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"attemptId\", attemptId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Mở lượt thi READY",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/exams/{{examId}}/attempts/{{attemptId}}/reset",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lecturerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().status).to.eql(\"READY\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Sinh viên bắt đầu thi",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/interviews/{{attemptId}}/start",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const state = pm.response.json().data;",
                  "pm.expect(state.status).to.eql(\"AWAITING_ANSWER\");",
                  "const questionTurnId = state.prompt.questionTurnId; pm.expect(questionTurnId).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"questionTurnId\", questionTurnId);",
                  "const mainTurnId = state.prompt.questionTurnId; pm.expect(mainTurnId).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"mainTurnId\", mainTurnId);",
                  "const questionAttemptId = state.prompt.questionAttemptId; pm.expect(questionAttemptId).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"questionAttemptId\", questionAttemptId);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đọc câu đầu bằng playback",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/interview/attempts/{{attemptId}}/speech/questions/{{questionTurnId}}/playback",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.questionTurnId).to.eql(pm.collectionVariables.get(\"questionTurnId\"));"
                ]
              }
            }
          ]
        }
      ],
      "description": "Sau Start, gửi audio câu chính ngay bằng trang speech-smoke. Deadline đã bắt đầu."
    },
    {
      "name": "03 — Kiểm tra AI hỏi xoáy",
      "item": [
        {
          "name": "Đọc câu follow-up sau answer.finalized",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/interviews/{{attemptId}}/current",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const state = pm.response.json().data;",
                  "pm.expect(state.status).to.eql(\"AWAITING_ANSWER\");",
                  "const questionTurnId = state.prompt.questionTurnId; pm.expect(questionTurnId).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"questionTurnId\", questionTurnId);",
                  "pm.test(\"AI đã tạo lượt hỏi mới trên cùng câu chính\", () => {",
                  "  pm.expect(state.prompt.questionTurnId).not.to.eql(pm.collectionVariables.get(\"mainTurnId\"));",
                  "  pm.expect(state.prompt.questionAttemptId).to.eql(pm.collectionVariables.get(\"questionAttemptId\"));",
                  "});"
                ]
              }
            }
          ]
        }
      ],
      "description": "Nếu PROCESSING, gửi lại sau khoảng một giây. COMPLETED tại bước này nghĩa là lần chạy chưa sinh follow-up. Kiểm tra transcript và cấu hình AI rồi chạy lại với câu trả lời còn thiếu. Khi có câu hỏi mới, gửi audio lần hai bằng questionTurnId mới."
    },
    {
      "name": "04 — Hoàn tất và chấm điểm",
      "item": [
        {
          "name": "Xác nhận kết thúc lượt thi",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/interviews/{{attemptId}}/current",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{studentToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.status).to.eql(\"COMPLETED\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Yêu cầu AI chấm transcript",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/question-attempts/{{questionAttemptId}}/evaluation/ai-grade",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lecturerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.status).to.eql(\"PENDING_REVIEW\");",
                  "const criteria = pm.response.json().data.criteria; pm.expect(criteria).to.be.an(\"array\").and.not.empty;",
                  "pm.collectionVariables.set(\"finalEvaluationBody\", JSON.stringify({criteria: criteria.map(c => ({criterionId: c.criterionId, finalScore: c.aiScore, comment: c.comment})), overallFeedback: \"Đã kiểm tra trong luồng thử.\"}));"
                ]
              }
            }
          ]
        },
        {
          "name": "Giảng viên chốt điểm",
          "request": {
            "method": "PUT",
            "url": "{{baseUrl}}/api/question-attempts/{{questionAttemptId}}/evaluation/final",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lecturerToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{{finalEvaluationBody}}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.status).to.eql(\"GRADED\");"
                ]
              }
            }
          ]
        },
        {
          "name": "Đọc kết quả đã chốt",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/question-attempts/{{questionAttemptId}}/evaluation",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{lecturerToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "pm.expect(pm.response.json().data.status).to.eql(\"GRADED\");"
                ]
              }
            }
          ]
        }
      ],
      "description": "Chạy sau khi speech chốt câu follow-up. Có thể chạy lại request kiểm tra hoàn tất nếu AI còn PROCESSING."
    },
    {
      "name": "Test riêng BE1 — Text + AI thật",
      "description": "Chạy từng request. Sau folder 02, nộp text câu chính, chạy folder 03 để lấy ID mới, rồi nộp text câu hỏi xoáy. Dùng profile local-test.",
      "item": [
        {
          "name": "Nộp text — Câu chính",
          "request": {
