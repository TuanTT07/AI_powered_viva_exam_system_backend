              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{lecturerEmail}}\",\n  \"password\": \"{{testPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const lecturerToken = pm.response.json().data.accessToken; pm.expect(lecturerToken).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"lecturerToken\", lecturerToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đăng nhập student bằng mật khẩu tạm",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{studentEmail}}\",\n  \"password\": \"{{initialPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const studentToken = pm.response.json().data.accessToken; pm.expect(studentToken).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"studentToken\", studentToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Đổi mật khẩu student",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/change-password",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
