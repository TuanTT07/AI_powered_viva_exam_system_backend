{
  "info": {
    "name": "AIVES — Full Interview E2E",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Dùng trên backend và DB thử nghiệm. Chạy từng folder theo thứ tự. Bước audio dùng doc/speech-smoke.html để gửi PCM thật qua WebSocket. Không chạy toàn bộ bằng Collection Runner một lần."
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    }
  ],
  "item": [
    {
      "name": "01 — Tạo tài khoản và môn học",
      "item": [
        {
          "name": "Đăng nhập admin",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/auth/login",
            "auth": {
              "type": "noauth"
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{adminEmail}}\",\n  \"password\": \"{{adminPassword}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const runId = Date.now().toString(36);",
                  "pm.collectionVariables.set(\"runId\", runId);",
                  "pm.collectionVariables.set(\"lecturerEmail\", \"viva-lecturer-\" + runId + \"@example.test\");",
                  "pm.collectionVariables.set(\"studentEmail\", \"viva-student-\" + runId + \"@example.test\");",
                  "const now = Date.now();",
                  "pm.collectionVariables.set(\"examStart\", new Date(now + 60000).toISOString());",
                  "pm.collectionVariables.set(\"examEnd\", new Date(now + 3600000).toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", () => pm.response.to.have.status(200));",
                  "const adminToken = pm.response.json().data.accessToken; pm.expect(adminToken).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"adminToken\", adminToken);"
                ]
              }
            }
          ]
        },
        {
          "name": "Tạo tài khoản lecturer",
          "request": {
            "method": "POST",
            "url": "{{baseUrl}}/api/admin/users",
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{adminToken}}",
                  "type": "string"
                }
              ]
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"roleName\": \"LECTURER\",\n  \"email\": \"{{lecturerEmail}}\",\n  \"password\": \"{{initialPassword}}\",\n  \"fullName\": \"Interview test lecturer\",\n  \"userCode\": \"lecturer-{{runId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 201\", () => pm.response.to.have.status(201));",
                  "const lecturerId = pm.response.json().data.id; pm.expect(lecturerId).to.be.a(\"string\").and.not.empty; pm.collectionVariables.set(\"lecturerId\", lecturerId);"
                ]
              }
            }
          ]
        },
