# Mẫu biến môi trường - file này ĐƯỢC commit.
# Thành viên mới: copy thành .env rồi sửa giá trị cho máy mình:
#   Windows (PowerShell): Copy-Item .env.example .env
#   Git Bash / macOS    : cp .env.example .env

# ---------- Database ----------
# CÁCH 1: Postgres local bằng Docker (docker compose up -d)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=aives
DB_USERNAME=aives
DB_PASSWORD=aives

# CÁCH 2: Supabase -> bỏ dấu # 3 dòng dưới và điền thông tin project
# Lấy ở Supabase: Project > Connect > Session pooler (KHÔNG dùng Direct connection, KHÔNG dùng port 6543)
# DB_URL=jdbc:postgresql://aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
# DB_USERNAME=postgres.<project-ref>
# DB_PASSWORD=<database-password>
DB_POOL_SIZE=5

# ---------- Server ----------
SERVER_PORT=8080

# ---------- AI (module 3, 4) ----------
AI_API_KEY=

# ---------- Đăng nhập (JWT) ----------
# Khoá ký token, tối thiểu 32 ký tự, mỗi môi trường (local / Render) nên dùng khoá khác nhau
JWT_SECRET=doi-chuoi-nay-thanh-chuoi-ngau-nhien-dai-it-nhat-32-ky-tu
JWT_EXPIRATION_MINUTES=120

# Tài khoản ADMIN đầu tiên: app tự tạo khi khởi động nếu DB chưa có ADMIN nào
ADMIN_EMAIL=admin@aives.local
ADMIN_PASSWORD=doi-mat-khau-nay

# ---------- CORS: domain FE được phép gọi API (cách nhau bằng dấu phẩy) ----------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
